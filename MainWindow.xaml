<Window x:Class="QuizApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuizApp"
        mc:Ignorable="d"
        Height="300"
        Width="400"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border CornerRadius="10"
            Background="WhiteSmoke"
            >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border CornerRadius="8"
                    Background="CornflowerBlue"
                    MouseLeftButtonDown="Border_MouseLeftButtonDown">
                <Grid HorizontalAlignment="Stretch">
                    <Label Content="Quiz App"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="15,0,0,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🗕"
                                Style="{StaticResource HeaderBtn}"
                                Margin="0,0,0,10"
                                Name="MinimizeBtn"
                                Click="MinimizeBtn_Click"/>
                        <Button Content="✖"
                                Style="{StaticResource HeaderBtn}"
                                Margin="0,0,10,0"
                                Name="CrossBtn"
                                Click="CrossBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,55,0">
                    <TextBlock
                           Text="Score : "                          
                           FontSize="14"
                           />
                    <TextBlock x:Name="ScoreCount"
                           Text="0"                          
                           FontSize="14"
                           />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Margin="35,0,0,0"
                           FontSize="14"
                           Name="QuestionBox"/>

                <StackPanel Grid.Row="2"
                            Margin="50,20,0,0"
                            Name="QuestionPanel">
                    <RadioButton x:Name="R1" Style="{StaticResource QuizOptions}" GroupName="Options"/>
                    <RadioButton x:Name="R2" Style="{StaticResource QuizOptions}" GroupName="Options"/>
                    <RadioButton x:Name="R3" Style="{StaticResource QuizOptions}" GroupName="Options"/>
                    <RadioButton x:Name="R4" Style="{StaticResource QuizOptions}" GroupName="Options"/>
                </StackPanel>

                <Button Grid.Row="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Next"
                        Width="120"
                        Name="NextBtn"
                        Style="{StaticResource PanelBtn}"
                        Click="NextBtn_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
